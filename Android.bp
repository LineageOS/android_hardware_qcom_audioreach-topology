soong_namespace {
}

filegroup {
    name: "audioreach-confs",
    srcs: [
        "*.m4",
        "**/*.m4",
    ],
}

genrule_defaults {
    name: "audioreach-cmd",
    cmd: "$(location m4) -I $$(dirname $$(awk '{print $$1}' <<< \"$(in)\")) $$(tr ' ' '\n' <<< \"$(in)\" |grep $$(basename -s \"-tplg.bin\" $(out))) > $(genDir)/$$(basename -s \"-tplg.bin\" $(out)).conf && $(location alsatplg) -c $(genDir)/$$(basename -s \"-tplg.bin\" $(out)).conf -o $(out)",
    tools: [
        "alsatplg",
        "m4",
    ],
    srcs: [":audioreach-confs"],
}

genrule {
    name: "qcom-sm8550-odin2-tplg-genrule",
    defaults: ["audioreach-cmd"],
    out: ["AYN-Odin2-tplg.bin"],
}
prebuilt_firmware {
    name: "qcom-sm8550-odin2-tplg",
    srcs: [":qcom-sm8550-odin2-tplg-genrule"],
    dsts: ["qcom/sm8550/AYN-Odin2-tplg.bin"],
    vendor: true,
}
