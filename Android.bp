soong_namespace {
}

filegroup {
    name: "audioreach-topology-includes",
    srcs: [
        "audioreach/**/*.m4",
        "util/**/*.m4",
    ],
}

audioreach_topology {
    name: "qcom-sm8550-odin2-topology",
    stem: "AYN-Odin2-tplg.bin",
    topology: "AYN-Odin2.m4",
    includes: [":audioreach-topology-includes"],
    relative_install_path: "qcom/sm8550",
}

audioreach_topology {
    name: "qcom-sm8750-ayn-topology",
    stem: "SM8750-AYN-tplg.bin",
    topology: "SM8750-AYN.m4",
    includes: [":audioreach-topology-includes"],
    relative_install_path: "qcom/sm8750",
}
